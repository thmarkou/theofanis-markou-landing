# =========================================================================
# Environment variables for Theofanis Markou landing.
# Copy this file to `.env` and fill in values for your local environment.
# In production, JWT_SECRET + DATABASE_URL are required (see server/_core/env.ts).
# OAuth / Manus vars are optional if you only use public routes (e.g. contact form).
# =========================================================================

# ---- Runtime ------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---- Session signing (ALWAYS required, any env) -------------------------
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# ---- Manus OAuth (required in production) -------------------------------
VITE_APP_ID=
OAUTH_SERVER_URL=

# ---- Database (optional) ------------------------------------------------
# Used only to persist contact messages / users. Not required for the free
# SMTP-only contact path. Leave empty if you have no MySQL host.
# Example: mysql://user:password@localhost:3306/theofanis_landing
DATABASE_URL=

# ---- Manus Forge storage proxy (optional) -------------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ---- Admin identification (optional) ------------------------------------
# When a user logs in whose openId matches this value, they are granted the
# "admin" role automatically.
OWNER_OPEN_ID=

# ---- Contact form → your Gmail (REQUIRED in production, €0) --------------
# Primary delivery path for the contact form (no paid database needed).
# Google Account → Security → 2-Step Verification → App passwords.
# Use the generated 16-character password as SMTP_PASS (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=theofanis.markou@gmail.com
SMTP_PASS=
# Recipient inbox (defaults to SMTP_USER if left empty):
CONTACT_TO_EMAIL=theofanis.markou@gmail.com

# ---- Client-side only (Vite picks these up automatically) --------------
# Umami (optional): self-hosted or Umami Cloud — used by client/src/main.tsx
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
# Google Analytics 4 (optional): measurement ID from GA4 Admin → Data streams
# Preferred (Next.js-style name, exposed via vite.config envPrefix):
NEXT_PUBLIC_GA_ID=
# Legacy alias — still read if NEXT_PUBLIC_GA_ID is empty
VITE_GA_MEASUREMENT_ID=
VITE_OAUTH_PORTAL_URL=
